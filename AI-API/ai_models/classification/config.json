{
  "seed": 42,
  "num_classes": 10,
  "image_size": 256,
  "resize_size": 288,
  "batch_size": 64,
  "epochs": 100,
  "stage1_epochs": 5,
  "warmup_pct": 0.1,
  "patience": 10,
  "stage1_backbone_lr": 3e-05,
  "stage1_classifier_lr": 0.0003,
  "backbone_lr": 2e-05,
  "classifier_lr": 0.00015,
  "min_lr": 1e-06,
  "weight_decay": 0.0005,
  "grad_clip_norm": 1.0,
  "num_workers": 2,
  "use_amp": true,
  "loss_name": "class_balanced_focal",
  "focal_gamma": 2.0,
  "cb_beta": 0.999,
  "label_smoothing": 0.03,
  "class_weight_power": 0.5,
  "sampler_weight_power": 0.35,
  "sampler_replacement": true,
  "mixup_alpha": 0.3,
  "mixup_prob": 0.3,
  "cutmix_alpha": 1.0,
  "cutmix_prob": 0.2,
  "random_erasing_prob": 0.25,
  "vertical_flip_prob": 0.2,
  "ema_decay": 0.999,
  "monitor_metric": "val_f1_macro",
  "output_dir": "/kaggle/working/output"
}