{
  "version": "v1",
  "task": "binary_classification",
  "purpose": "Input validation gate — reject non-skin images before dermatology pipeline",

  "model": {
    "architecture": "EfficientNet-B0",
    "backbone": "efficientnet_b0",
    "head": "Dropout(0.3) -> Linear(1280, 1)",
    "pretrained": "ImageNet",
    "framework": "timm",
    "num_classes": 1,
    "output": "logit (use sigmoid for probability)"
  },

  "inference": {
    "img_size": 224,
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225],
    "threshold": 0.5,
    "color_space": "RGB",
    "interpolation": "LANCZOS"
  },

  "classes": {
    "0": "non_person_skin",
    "1": "person_skin"
  },

  "class_logic": {
    "positive_class": "person_skin",
    "positive_label": 1,
    "decision": "sigmoid(logit) > threshold => person_skin, else non_person_skin"
  },

  "training": {
    "dataset": "Custom (ISIC skin + COCO non-person + hard negatives)",
    "train_size": 3517,
    "val_size": 753,
    "test_size": 756,
    "split_ratio": "70/15/15",
    "epochs": 30,
    "batch_size": 32,
    "optimizer": "AdamW",
    "lr_head": 1e-3,
    "lr_encoder": 1e-4,
    "scheduler": "CosineAnnealingLR",
    "loss": "BCEWithLogitsLoss + LabelSmoothing(0.05)",
    "weight_decay": 1e-4,
    "gradient_clip": 1.0,
    "early_stopping_patience": 7,
    "amp": true
  },

  "augmentation": {
    "train": [
      "HorizontalFlip(p=0.5)",
      "Rotate(limit=15, p=0.3)",
      "RandomBrightnessContrast(0.2, 0.2, p=0.4)",
      "GaussianBlur(3-5, p=0.2)",
      "ColorJitter(p=0.3)",
      "HueSaturationValue(p=0.3)"
    ],
    "val_test": ["Normalize only"]
  },

  "files": {
    "best_model": "best_model_binary.pth",
    "final_model": "final_model_binary.pth",
    "config": "skin_gate_config.json",
    "inference": "inference.py"
  }
}
