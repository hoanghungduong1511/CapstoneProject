# ══════════════════════════════════════════════════════════════════════
# SkinDiseases AI Service — Environment Variables
# ══════════════════════════════════════════════════════════════════════

# ── Project ──────────────────────────────────────────────────────────
PROJECT_NAME=SkinDiseases AI Service
VERSION=1.0.0

# ── Server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=info

# ── AI Models ────────────────────────────────────────────────────────
# Đường dẫn tới thư mục chứa model weights
# Trong Docker: /app/ai_models (mặc định)
# Local: ./ai_models
# MODEL_DIR=./ai_models

# Device: "auto" (tự detect), "cuda", "cpu"
DEVICE=auto

# ── Upload limits ────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10

# Medical chatbot
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=120
RAG_MODE=pgvector
RAG_TOP_K=5
RAG_MIN_SCORE=0.05
VECTOR_INDEX_DIR=./data/processed/chatbot/vector_index_st
CHATBOT_TEMPERATURE=0.3
CHATBOT_MAX_TOKENS=800
VECTOR_DB_ENABLED=false
PGVECTOR_DATABASE_URL=
PGVECTOR_TABLE=disease_knowledge_chunks
PGVECTOR_EMBEDDING_PROVIDER=sentence-transformers
PGVECTOR_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# DISEASE_KNOWLEDGE_PATH=./data/processed/chatbot/disease_knowledge.csv
