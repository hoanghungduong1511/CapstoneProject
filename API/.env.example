# ══════════════════════════════════════════════════════════════════════
# SkinDiseases API — Environment Variables (TEMPLATE)
# Sao chép file này thành .env và chỉnh sửa giá trị phù hợp
# ══════════════════════════════════════════════════════════════════════

# ── Project ──────────────────────────────────────────────────────────
PROJECT_NAME=SkinDiseases API

# ── PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=skin_diseases

# ── Security ─────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Google OAuth 2.0 ─────────────────────────────────────────────────
# Tạo credentials tại: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ── MinIO (Object Storage) ───────────────────────────────────────────
# Console UI: http://localhost:9001
MINIO_URL=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=skin-diseases-images
MINIO_SECURE=false

# AI inference and chatbot service
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_TIMEOUT=60

# These values are forwarded to the ai-service by docker-compose.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RAG_MODE=csv
RAG_TOP_K=5
CHATBOT_TEMPERATURE=0.3
CHATBOT_MAX_TOKENS=800
VECTOR_DB_ENABLED=false
